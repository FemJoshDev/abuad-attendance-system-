generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String?            @unique
  matricNumber       String?            @unique
  passwordHash       String
  fullName           String
  role               Role               @default(STUDENT)
  
  // Academic Profile Metadata
  level              Level?             // Optional for LECTURER / ADMIN, required for STUDENT
  department         String?            // e.g. "Medicine & Surgery"
  college            String?            // e.g. "College of Medicine & Health Sciences"
  
  avatarUrl          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  attendanceLogs     AttendanceLog[]
  assignedComplaints Complaint[]        @relation("AssignedComplaints")
  filedComplaints    Complaint[]        @relation("FiledComplaints")
  taughtCourses      Course[]           @relation("LecturerCourses")
  enrollments        CourseEnrollment[]
  notifications      Notification[]

  @@index([role])
  @@index([level])
}

model Course {
  id                 String              @id @default(cuid())
  code               String              @unique // e.g. "MBBS 501"
  title              String              // e.g. "Anatomy V"
  description        String?
  units              Int                 @default(3) // Credit units
  
  // Placement Filters
  level              Level               @default(LEVEL_100)
  semester           Semester            @default(FIRST)
  department         String?             // e.g. "Medicine & Surgery"
  
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lecturerId         String?
  
  attendanceSessions AttendanceSession[]
  complaints         Complaint[]
  lecturer           User?               @relation("LecturerCourses", fields: [lecturerId], references: [id])
  enrollments        CourseEnrollment[]

  @@index([lecturerId])
  @@index([level, semester])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model AttendanceSession {
  id           String          @id @default(cuid())
  courseId     String
  isOpen       Boolean         @default(true)
  latitude     Float
  longitude    Float
  radiusMeters Float           @default(100.0)
  createdAt    DateTime        @default(now())
  closedAt     DateTime?
  logs         AttendanceLog[]
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([isOpen])
}

model AttendanceLog {
  id             String            @id @default(cuid())
  sessionId      String
  studentId      String
  status         AttendanceStatus  @default(PRESENT)
  latitude       Float
  longitude      Float
  distanceMeters Float
  markedAt       DateTime          @default(now())
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model Complaint {
  id           String          @id @default(cuid())
  title        String
  description  String
  status       ComplaintStatus @default(PENDING)
  response     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  studentId    String
  courseId     String?
  assignedToId String?
  assignedTo   User?           @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  course       Course?         @relation(fields: [courseId], references: [id])
  student      User            @relation("FiledComplaints", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([assignedToId])
  @@index([courseId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum Level {
  LEVEL_100
  LEVEL_200
  LEVEL_300
  LEVEL_400
  LEVEL_500
  LEVEL_600
}

enum Semester {
  FIRST
  SECOND
}

enum ComplaintStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}